# Local development only. Never commit an actual .env or credentials.
GATEWAY_MODE=sandbox
LIVE_CALLS_ENABLED=false
GLOBAL_PAUSED=false
APP_ORIGIN=http://localhost:3000
GATEWAY_DATA_DIR=.data

# PostgreSQL is mandatory for shared/cloud deployments. Empty uses local sandbox storage.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Exactly 32 random bytes encoded as 64 hexadecimal characters. Setup generates local keys.
GATEWAY_ENCRYPTION_KEY=

# Evidence storage. Provision and verify versioning/Object Lock separately.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_EVIDENCE_BUCKET=
# A retention period is not legal approval. Keep zero until the retention matrix is reviewed.
EVIDENCE_RETENTION_DAYS=0

# External review references; do not fill with placeholder approvals.
LEGAL_APPROVAL_REFERENCE=
APPROVED_POLICY_VERSIONS=
LEMON_SQUEEZY_APPROVED=false
BILLING_APPROVAL_REFERENCE=
